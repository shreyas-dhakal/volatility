  "narrative": {
    "northStar": "The Architecture Working Notebook",
    "overview": "Galvanise uses the incumbent Astryx neutral identity: restrained grayscale surfaces, Figtree typography and compact controls around a spacious working column. The interface feels like a working notebook for architecture decisions, with conversation, evidence and review taking priority over decoration.\n\nThe creative north star names the implemented character; it does not introduce a replacement brand. Color is reserved for graph meaning. Labels, provenance, review states and edge styles keep claims distinguishable without implying measured certainty.",
    "keyCharacteristics": [
      "Neutral surfaces and dark primary actions.",
      "Spacious conversation, compact navigation and evidence rows.",
      "Explicit provenance, uncertainty and review actions.",
      "Graph color reinforced by labels and line style."
    ],
    "rules": [
      {
        "name": "The Evidence Color Rule",
        "body": "Graph color identifies a semantic category, never verification or a probability score. Retain labels and dashed versus solid edge treatment.",
        "section": "colors"
      },
      {
        "name": "The Reading Hierarchy Rule",
        "body": "Use heading levels to structure tasks, body text for reasoning and supporting text for evidence qualifiers. Keep essential uncertainty legible rather than hiding it in color alone.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Organize persistent working regions with semantic fills and dividers; reserve library elevation for transient controls that require it.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the supported Astryx components and semantic CSS properties.",
      "Do keep evidence status, review status, version and provenance visible together.",
      "Do provide labelled controls and a reachable composer at narrow widths.",
      "Do preserve source confidence as an upstream claim and identify synthetic sample evidence."
    ],
    "donts": [
      "Don't introduce a new brand accent or decorative chart palette.",
      "Don't imply that repository file indexing establishes dependency relationships.",
      "Don't present qualitative scenario assumptions as measured savings or verified impact.",
      "Don't claim dark-mode, mobile-drawer modality or reduced-motion coverage beyond the implementation."
    ]
  }
}
