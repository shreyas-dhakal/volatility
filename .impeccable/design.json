      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Astryx primary action; preserved semantic treatment.",
      "html": "<button class=\"ds-button-primary\"><svg class=\"ds-button-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m22 2-7 20-4-9-9-4Z\"/><path d=\"M22 2 11 13\"/></svg>Send</button>",
      "css": ".ds-button-primary{font-family:var(--font-family-body,Figtree,Arial,sans-serif);font-size:var(--text-label-size,.875rem);font-weight:500;line-height:1.4286;display:inline-flex;align-items:center;justify-content:center;padding:.5rem .75rem;min-width:0;height:32px;border:0;border-radius:var(--radius-element,.625rem);cursor:pointer;transition:background-color var(--duration-fast,125ms) var(--ease-standard,cubic-bezier(.24,1,.4,1)),transform 125ms;background:var(--color-accent,#1b1b1b);color:var(--color-on-accent,#fff);}.ds-button-primary:hover{background-image:linear-gradient(var(--color-overlay-hover,#0000000d),var(--color-overlay-hover,#0000000d));}.ds-button-primary:focus-visible{outline:2px solid var(--color-accent,#1b1b1b);outline-offset:3px;}.ds-button-primary:active{transform:scale(.98);}.ds-button-primary:disabled{opacity:.5;cursor:default;transform:none;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}.ds-button-primary:active{transform:none;}} .ds-button-primary{gap:.5rem}.ds-button-icon{flex-shrink:0}"
